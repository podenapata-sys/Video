 "captions": [
  {
   "line": 1,
   "text": "ঢাকার এই শহরে সে সফল হয়েছে...",
   "start": 0.5,
   "end": 3.066
  },
  {
   "line": 1,
   "text": "কিন্তু ফোনের পর্দায় চৌদ্দটা মিসড কল,",
   "start": 3.701,
   "end": 6.213
  },
  {
   "line": 1,
   "text": "শুধু একটাই নাম...",
   "start": 6.749,
   "end": 7.773
  },
  {
   "line": 1,
   "text": "আম্মু।",
   "start": 8.422,
   "end": 8.802
  },
  {
   "line": 2,
   "text": "গ্রামের বারান্দায়,",
   "start": 9.434,
   "end": 10.462
  },
  {
   "line": 2,
   "text": "প্রতি রাতে এক মা দুটো থালা সাজায়...",
   "start": 10.805,
   "end": 13.027
  },
  {
   "line": 2,
   "text": "আর একটা থালা ঢেকে রাখে।",
   "start": 13.612,
   "end": 15.189
  },
  {
   "line": 3,
   "text": "সেই রাতে একটা মেসেজ সব থামিয়ে দিল...",
   "start": 15.837,
   "end": 18.267
  },
  {
   "line": 3,
   "text": "\"বাবা,",
   "start": 18.834,
   "end": 19.146
  },
  {
   "line": 3,
   "text": "ভাত খাইছো?\"",
   "start": 19.529,
   "end": 20.152
  },
  {
   "line": 4,
   "text": "সব সাফল্য ফেলে সে রওনা দিল...",
   "start": 20.525,
   "end": 22.579
  },
  {
   "line": 4,
   "text": "মায়ের কাছে।",
   "start": 23.037,
   "end": 23.767
  },
  {
   "line": 5,
   "text": "মাঝরাত।",
   "start": 24.275,
   "end": 24.987
  },
  {
   "line": 5,
   "text": "ঘরের বাতিটা তখনো জ্বলছে...",
   "start": 25.346,
   "end": 27.052
  },
  {
   "line": 5,
   "text": "কারণ মা জানত,",
   "start": 27.567,
   "end": 28.555
  },
  {
   "line": 5,
   "text": "ছেলে একদিন ফিরবেই।",
   "start": 28.93,
   "end": 30.056
  },
  {
   "line": 6,
   "text": "মা কখনো ক্লান্ত হয় না...",
   "start": 30.576,
   "end": 32.186
  },
  {
   "line": 6,
   "text": "শুধু অপেক্ষা করে।",
   "start": 32.656,
   "end": 33.806
  },
  {
   "line": 6,
   "text": "আজ কি আপনি মাকে ফোন করেছেন?",
   "start": 34.42,
   "end": 36.503
  }
 ],
