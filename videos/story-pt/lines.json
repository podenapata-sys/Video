[
 {
  "line": 1,
  "start": 0.15,
  "end": 2.603,
  "text": "The text came at two fourteen a.m."
 },
 {
  "line": 2,
  "start": 2.743,
  "end": 4.187,
  "text": "It was from no name."
 },
 {
  "line": 3,
  "start": 4.327,
  "end": 5.906,
  "text": "Then the phone buzzed again."
 },
 {
  "line": 4,
  "start": 6.046,
  "end": 8.435,
  "text": "Stay indoors. Do not answer."
 },
 {
  "line": 5,
  "start": 8.575,
  "end": 10.464,
  "text": "Her apartment is on floor nine."
 },
 {
  "line": 6,
  "start": 10.604,
  "end": 12.793,
  "text": "The stairs are the only way down."
 },
 {
  "line": 7,
  "start": 12.933,
  "end": 16.223,
  "text": "Rule number one. Don't answer unknown calls."
 },
 {
  "line": 8,
  "start": 16.363,
  "end": 17.651,
  "text": "It's her mother's voice."
 },
 {
  "line": 9,
  "start": 17.791,
  "end": 20.082,
  "text": "Rule number two. Count the stairs."
 },
 {
  "line": 10,
  "start": 20.222,
  "end": 21.813,
  "text": "Count every step."
 },
 {
  "line": 11,
  "start": 21.953,
  "end": 24.099,
  "text": "There's one more step than there should be."
 },
 {
  "line": 12,
  "start": 24.239,
  "end": 26.706,
  "text": "Rule number three. Porch light off."
 },
 {
  "line": 13,
  "start": 26.846,
  "end": 29.37,
  "text": "The lobby light is on. Don't go toward it."
 },
 {
  "line": 14,
  "start": 29.51,
  "end": 31.679,
  "text": "Someone is already in the doorway."
 },
 {
  "line": 15,
  "start": 31.819,
  "end": 35.121,
  "text": "Rule number four. Never say yes to the door."
 },
 {
  "line": 16,
  "start": 35.261,
  "end": 36.872,
  "text": "It asks, \"Can I come in?\""
 },
 {
  "line": 17,
  "start": 37.012,
  "end": 39.424,
  "text": "It says her name right. It says it wrong."
 },
 {
  "line": 18,
  "start": 40.124,
  "end": 41.186,
  "text": "Do you open it?"
 }
]