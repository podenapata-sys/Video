 ],
 "captions": [
  {
   "slot": 1,
   "text": "মা'র ফোন এলে আমি কেটে দিতাম।",
   "start": 0.5,
   "end": 3.32
  },
  {
   "slot": 1,
   "text": "গেমের কাছে তখন বাকি সবকিছু জিরো ছিল।",
   "start": 3.32,
   "end": 7.0
  },
  {
   "slot": 2,
   "text": "ওদিকে এক মা প্রতিদিন দু'জনের ভাত বেড়ে রাখত।",
   "start": 7.3,
   "end": 10.82
  },
  {
   "slot": 2,
   "text": "মেসেজ পাঠাত…",
   "start": 10.82,
   "end": 12.11
  },
  {
   "slot": 2,
   "text": "Seen হতো, রিপ্লাই আসত না।",
   "start": 12.11,
   "end": 14.58
  },
  {
   "slot": 3,
   "text": "বন্ধুদের আড্ডায় ফোনটা পড়ে থাকত।",
   "start": 14.88,
   "end": 17.3
  },
  {
   "slot": 3,
   "text": "আমি ভাবতাম, এটাই জীবন।",
   "start": 17.3,
   "end": 19.85
  },
  {
   "slot": 4,
   "text": "তারপর এক রাতে একটা কল এলো…",
   "start": 20.88,
   "end": 23.49
  },
  {
   "slot": 4,
   "text": "মা'র নম্বর থেকে…",
   "start": 23.49,
   "end": 26.23
  },
  {
   "slot": 4,
   "text": "সেদিন বুঝলাম, অনেক দেরি হয়ে গেছে…",
   "start": 26.23,
   "end": 30.26
  },
  {
   "slot": 5,
   "text": "ফোনে ছিল ৪৭টা না-পড়া মেসেজ।",
   "start": 30.56,
   "end": 33.22
  },
  {
   "slot": 5,
   "text": "শেষ ভয়েসে মা শুধু বলেছিল…",
   "start": 33.22,
   "end": 35.42
  },
  {
   "slot": 5,
   "text": "“বাবা, ভাত খাইছো?”",
   "start": 35.42,
   "end": 37.61
  },
  {
   "slot": 6,
   "text": "একটা ফোন করিস, আর কিছু চাই না…",
   "start": 37.91,
   "end": 41.76
  },
  {
   "slot": 6,
   "text": "আজ কি আপনি মাকে রিপ্লাই দিয়েছেন?",
   "start": 41.76,
   "end": 44.536
  }
 ],
